# Where the NestJS API runs. /api on the web app is forwarded here.
API_ORIGIN=http://localhost:4000

# Map style (MapLibre style JSON URL). The default is a free vector style.
# For the satellite look in the design, use a MapTiler satellite-hybrid style
# with a key, e.g. https://api.maptiler.com/maps/hybrid/style.json?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Set to 1 to run the screens on built-in sample data with no API.
NEXT_PUBLIC_API_MOCK=0
