# Where the NestJS API runs. /api on the web app is forwarded here.
API_ORIGIN=http://localhost:4000

# Street map style (MapLibre style JSON URL). The default is a free vector style.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Satellite, offered by a Map / Satellite switch in the Layers panel. MapTiler's
# satellite-hybrid style with its key (restrict the key to the app's domains):
#   https://api.maptiler.com/maps/hybrid/style.json?key=YOUR_MAPTILER_KEY
# Optional: an ArcGIS Location Platform key for Esri World Imagery, used for
# satellite when the MapTiler URL is empty. With neither, the switch is hidden.
NEXT_PUBLIC_SATELLITE_STYLE_URL=
NEXT_PUBLIC_ESRI_IMAGERY_KEY=

# Set to 1 to run the screens on built-in sample data with no API.
NEXT_PUBLIC_API_MOCK=0
